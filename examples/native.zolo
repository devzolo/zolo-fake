// Feature: one native plugin call per chunk for high-volume fake data.
// First build zolo-plugin-fake-native, then run this file from this project.

use fake::{Fake, FakeNative}
use fake::native::{NativeFaker}

struct User deriving Fake, FakeNative {
  @provider(.UuidV4)
  @unique
  id: str,
  @provider(.FullName)
  name: str,
  @provider(.SafeEmail)
  @unique
  email: str,
  @range(18, 90)
  age: int,
  active: bool,
}

let faker = NativeFaker.new(seed: 42, locale: "pt-BR", chunk_size: 4096)
let users = User::fake_many_native(faker, 100_000)
print("generated rows: {users.len()}")
let engine_name = faker.engine()["name"]
print("engine: {engine_name}")
