// ── typed derive ──────────────────────────────────────────────────

/// The decorators `Fake` and `FakeNative` read on a field. They come with
/// either generator, so a type that derives one of them imports nothing more.
pub mod marks {
  /// The provider of a field's value, when it should not be inferred.
  pub decorator provider(kind: Provider = .Auto) mark field

  /// The closed range of an integer or float field, and of the elements of
  /// an `[int]` field.
  pub decorator range(min: int = 0, max: int = 1000)
    mark field
    check {
      if min > max {
        error("min must be <= max", at: min, code: "fake/invalid-range")
      }
    }

  /// The chance of `true` for a bool field.
  pub decorator chance(probability: float = 0.5)
    mark field
    check {
      if probability < 0.0 || probability > 1.0 {
        error("probability must be in [0, 1]", at: probability, code: "fake/invalid-probability")
      }
    }

  /// The chance that an optional field has a value.
  pub decorator present(probability: float = 0.7)
    mark field where type: _?
    check {
      if probability < 0.0 || probability > 1.0 {
        error("probability must be in [0, 1]", at: probability, code: "fake/invalid-probability")
      }
    }

  /// How many elements a list field gets.
  pub decorator length(min: int = 0, max: int = 4)
    mark field where type: [_] | [_]?
    check {
      if min > max {
        error("min must be <= max", at: min, code: "fake/invalid-length")
      }
    }

  /// No two generated rows share this field's value.
  pub decorator unique mark field

  /// Leave the field at its zero value.
  pub decorator ignore mark field

  /// Turn name-based inference off for one field: `@infer(false)`.
  pub decorator infer(enabled: bool = true) mark field
}

@comptime
fn fake_provider_name(field, inferring: bool) -> str {
  let chosen = field.opts(provider).kind
  if chosen != Provider::Auto { return chosen.__variant }
  // `@chance(p)` says what the field is as well as how likely.
  if field.mark(chance) != nil { return "Chance" }
  let kind = if field.type.is_optional { field.type.inner.kind } else { field.type.kind }
  // Structural types win over semantic field-name inference. A field named
  // `name` whose type is an enum or nested model is not a person's full name.
  if kind == "enum" { return "Enum" }
  if kind == "list" { return "List" }
  if kind == "ref" { return "Nominal" }
  let name = field.name
  if inferring && field.opts(infer).enabled {
    if name == "id" || name == "user_id" || name == "account_id" || name == "order_id" {
      return if kind == "str" { "UuidV4" } else { "Int" }
    }
    if name == "name" || name == "full_name" || name == "owner_name" { return "FullName" }
    if name == "first_name" { return "FirstName" }
    if name == "last_name" { return "LastName" }
    if name == "username" || name == "user_name" { return "Username" }
    if name == "email" || name == "user_email" || name == "contact_email" { return "SafeEmail" }
    if name == "city" { return "City" }
    if name == "state" { return "State" }
    if name == "postcode" || name == "postal_code" || name == "zip" { return "Postcode" }
    if name == "street" || name == "street_name" { return "Street" }
    if name == "company" || name == "company_name" { return "CompanyName" }
    if name == "profession" || name == "job_title" { return "Profession" }
    if name == "industry" { return "Industry" }
    if name == "active" || name == "enabled" { return "Chance" }
  }
  if fake_is_integer_kind(kind) {
    return "Int"
  }
  if kind == "float" || kind == "f32" || kind == "f64" { return "Float" }
  if kind == "bool" { return "Chance" }
  if kind == "str" { return "Word" }
  return "Unsupported"
}

@comptime
fn fake_is_integer_kind(kind: str) -> bool {
  let signed = kind == "int" || kind == "i8" || kind == "i16" || kind == "i32" || kind == "i64"
  let unsigned = kind == "u8" || kind == "u16" || kind == "u32" || kind == "u64"
  return signed || unsigned
}

@comptime
fn fake_is_numeric_kind(kind: str) -> bool {
  return fake_is_integer_kind(kind) || kind == "float" || kind == "f32" || kind == "f64"
}

@comptime
fn fake_is_text_provider(provider: str) -> bool {
  let person = provider == "Word" || provider == "FirstName" || provider == "LastName" || provider == "FullName"
  let internet = provider == "Username" || provider == "SafeEmail" || provider == "Domain" || provider == "Ipv4"
  let location = provider == "City" || provider == "State" || provider == "Postcode" || provider == "Street"
  let company = provider == "CompanyName" || provider == "Profession" || provider == "Industry"
  let other = provider == "Sentence" || provider == "Paragraph" || provider == "UuidV4" || provider == "Sequence"
  return person || internet || location || company || other
}

@comptime
fn fake_validate(field, provider: str) {
  let kind = if field.type.is_optional { field.type.inner.kind } else { field.type.kind }
  let numeric = provider == "Int" || provider == "Float"
  let text = fake_is_text_provider(provider)
  if numeric && !fake_is_numeric_kind(kind) {
    panic("fake: numeric provider is incompatible with field `" + field.name + "`")
  }
  if text && kind != "str" {
    panic("fake: text provider is incompatible with field `" + field.name + "`")
  }
  if provider == "Chance" && kind != "bool" {
    panic("fake: Chance is only valid for bool field `" + field.name + "`")
  }
  if provider == "Enum" && kind != "enum" {
    panic("fake: Enum provider is only valid for enum field `" + field.name + "`")
  }
  if provider == "Nominal" && kind != "ref" {
    panic("fake: Nominal provider is only valid for nested field `" + field.name + "`")
  }
  if provider == "Unsupported" {
    panic(
      "fake: no structural or nominal provider for field `" + field.name + "` of type `" + field.type.name + "`",
    )
  }
}

@comptime
fn fake_scalar_expr(field, provider: str, path) -> Syntax<.Expr> {
  let value_type = if field.type.is_optional { field.type.inner } else { field.type }
  let probability = field.opts(chance).probability
  let limits = field.opts(range)
  if provider == "Int" {
    return quote expr { faker.int_at(row, path_prefix + "." + ${path}, ${limits.min}, ${limits.max}) }
  }
  if provider == "Float" {
    return quote expr {
      faker.float_at(
        row,
        path_prefix + "." + ${path},
        ${limits.min} as float,
        ${limits.max} as float,
      )
    }
  }
  if provider == "Chance" {
    return quote expr { faker.chance_at(row, path_prefix + "." + ${path}, ${probability}) }
  }
  if provider == "Word" { return quote expr { faker.word_at(row, path_prefix + "." + ${path}) } }
  if provider == "FirstName" {
    return quote expr { faker.first_name_at(row, path_prefix + "." + ${path}) }
  }
  if provider == "LastName" {
    return quote expr { faker.last_name_at(row, path_prefix + "." + ${path}) }
  }
  if provider == "FullName" {
    return quote expr { faker.full_name_at(row, path_prefix + "." + ${path}) }
  }
  if provider == "Username" {
    return quote expr { faker.username_at(row, path_prefix + "." + ${path}) }
  }
  if provider == "SafeEmail" {
    return quote expr { faker.safe_email_at(row, path_prefix + "." + ${path}) }
  }
  if provider == "Domain" {
    return quote expr { faker.domain_at(row, path_prefix + "." + ${path}) }
  }
  if provider == "Ipv4" { return quote expr { faker.ipv4_at(row, path_prefix + "." + ${path}) } }
  if provider == "City" { return quote expr { faker.city_at(row, path_prefix + "." + ${path}) } }
  if provider == "State" {
    return quote expr { faker.state_name_at(row, path_prefix + "." + ${path}) }
  }
  if provider == "Postcode" {
    return quote expr { faker.postcode_at(row, path_prefix + "." + ${path}) }
  }
  if provider == "Street" {
    return quote expr { faker.street_at(row, path_prefix + "." + ${path}) }
  }
  if provider == "CompanyName" {
    return quote expr { faker.company_name_at(row, path_prefix + "." + ${path}) }
  }
  if provider == "Profession" {
    return quote expr { faker.profession_at(row, path_prefix + "." + ${path}) }
  }
  if provider == "Industry" {
    return quote expr { faker.industry_at(row, path_prefix + "." + ${path}) }
  }
  if provider == "Sentence" {
    return quote expr { faker.sentence_at(row, path_prefix + "." + ${path}) }
  }
  if provider == "Paragraph" {
    return quote expr { faker.paragraph_at(row, path_prefix + "." + ${path}) }
  }
  if provider == "UuidV4" {
    return quote expr { faker.uuid_v4_at(row, path_prefix + "." + ${path}) }
  }
  if provider == "Sequence" { return quote expr { faker.sequence_at(row) } }
  if provider == "Enum" {
    let variants = value_type.variants.map(
      |variant| {
        let member = syntax.ident(variant)
        return quote expr { ${value_type.ref}::${member} }
      },
    )
    return quote expr {
      [${..variants}][faker.int_at(row, path_prefix + "." + ${path}, 0, ${variants.len() - 1})]
    }
  }
  if provider == "Nominal" {
    return quote expr { ${value_type.ref}::fake_at(faker, row, path_prefix + "." + ${path}) }
  }
  return quote expr { nil }
}

@comptime
fn fake_field_expr(field, provider: str) -> Syntax<.Expr> {
  let path = field.name
  let limits = field.opts(range)
  let sizes = field.opts(length)
  if field.mark(ignore) != nil {
    if field.type.is_optional { return quote expr { nil } }
    if field.type.kind == "str" { return quote expr { "" } }
    if field.type.kind == "bool" { return quote expr { false } }
    if field.type.kind == "float" { return quote expr { 0.0 } }
    return quote expr { 0 }
  }
  let value_type = if field.type.is_optional { field.type.inner } else { field.type }
  var value = fake_scalar_expr(field, provider, path)
  if value_type.kind == "list" {
    let inner = value_type.inner.kind
    if inner == "str" {
      value = quote expr {
        {
          let count = faker.int_at(
            row,
            path_prefix + "." + ${path} + ".len",
            ${sizes.min},
            ${sizes.max},
          )
          var values: [str] = []
          for index in 0..count { values.push(faker.word_at(row, path_prefix + "." + ${path} + "." + "{index}")) }
          values
        }
      }
    }
    if inner == "int" {
      value = quote expr {
        {
          let count = faker.int_at(
            row,
            path_prefix + "." + ${path} + ".len",
            ${sizes.min},
            ${sizes.max},
          )
          var values: [int] = []
          for index in 0..count {
            values.push(
              faker.int_at(
                row,
                path_prefix + "." + ${path} + "." + "{index}",
                ${limits.min},
                ${limits.max},
              ),
            )
          }
          values
        }
      }
    }
    if inner != "str" && inner != "int" {
      panic("fake: v1 list derive supports [str] and [int] on field `" + field.name + "`")
    }
  }
  if field.type.is_optional {
    let presence = field.opts(present).probability
    return quote expr {
      if faker.chance_at(row, path_prefix + "." + ${path} + ".present", ${presence}) {
        ${value}
      } else {
        nil
      }
    }
  }
  return value
}

@comptime
fn fake_native_field_expr(field) -> Syntax<.Expr> {
  if field.mark(ignore) != nil {
    if field.type.is_optional { return quote expr { nil } }
    if field.type.kind == "str" { return quote expr { "" } }
    if field.type.kind == "bool" { return quote expr { false } }
    if field.type.kind == "float" { return quote expr { 0.0 } }
    return quote expr { 0 }
  }
  return quote expr { columns[${field.name}][index] }
}

@comptime
fn fake_schema_hash(info, providers) -> int {
  var hash = 17
  for field in info.fields {
    let text = info.name + "." + field.name + ":" + field.type.name + ":" + providers[field.index]
    for byte in text.bytes() { hash = (hash * 131 + byte + 1) % 2147483647 }
  }
  return hash
}

/// The plan entry of one field, shared by the portable and the native
/// generator.
@comptime
fn fake_plan_field(info, field, provider: str) -> Syntax<.Expr> {
  let limits = field.opts(range)
  let sizes = field.opts(length)
  let probability = if field.type.is_optional {
    field.opts(present).probability
  } else { field.opts(chance).probability }
  let value_type = if field.type.is_optional { field.type.inner } else { field.type }
  let inner_kind = if value_type.kind == "list" { value_type.inner.kind } else { "" }
  let variants = value_type.variants.map(|variant| quote expr { ${variant} })
  let ignored = field.mark(ignore) != nil
  let distinct = field.mark(unique) != nil
  return quote expr {#{
    "name": ${field.name},
    "path": ${info.name + "." + field.name},
    "kind": ${value_type.kind},
    "type_name": ${value_type.name},
    "inner_kind": ${inner_kind},
    "provider": ${provider},
    "min": ${limits.min},
    "max": ${limits.max},
    "min_len": ${sizes.min},
    "max_len": ${sizes.max},
    "probability": ${probability},
    "optional": ${field.type.is_optional},
    "ignored": ${ignored},
    "unique": ${distinct},
    "variants": [${..variants}],
  }}
}

/// Generator imported as `Fake`: `struct User deriving Fake { ... }`. It
/// owns the decorators in `marks`. `infer: false` turns name-based inference
/// off for the whole type.
pub derive Fake(infer: bool = true) owns marks {
  expand enum(info) -> Syntax<.Items> {
    for variant in info.variants {
      if variant.payload != nil {
        panic("fake: enum derive v1 supports payload-free variants only")
      }
    }
    let choices = info.variants.map(
      |variant| {
        let member = syntax.ident(variant.name)
        return quote expr { ${info.ref}::${member} }
      },
    )
    let variant_names = info.variants.map(|variant| quote expr { ${variant.name} })
    return quote items {
      impl ${info.ref} {
        pub fn fake(faker: Faker) -> ${info.ref} {
          let row = faker.reserve(1)
          return ${info.ref}::fake_at(faker, row, ${info.name})
        }
        pub fn fake_at(faker: Faker, row: int, path_prefix: str = ${info.name}) -> ${info.ref} {
          return [${..choices}][faker.int_at(row, path_prefix, 0, ${choices.len() - 1})]
        }
        @allow(max_nesting_depth)
        pub fn fake_many(faker: Faker, count: int) -> [${info.ref}] {
          if count < 0 { panic("fake: count must be non-negative") }
          let start = faker.reserve(count)
          var values: [${info.ref}] = []
          for index in 0..count { values.push(${info.ref}::fake_at(faker, start + index, ${info.name})) }
          return values
        }
        pub fn fake_plan() -> {str: Any} {
          return #{
            "type_name": ${info.name},
            "schema_hash": 17,
            "variants": [${..variant_names}],
            "algorithm": "portable-v1",
          }
        }
      }
    }
  }

  expand struct, schema(info) -> Syntax<.Items> {
    let providers = info.fields.map(|field| fake_provider_name(field, infer))
    for field in info.fields { fake_validate(field, providers[field.index]) }
    let arguments = info.fields.map(|field| fake_field_expr(field, providers[field.index]))
    let unique_fields = info.fields.filter(|field| field.mark(unique) != nil)
    let unique_checks = unique_fields.map(
      |field| quote stmt {
      if candidate.${field.member} != nil && _seen[${field.name} + ":" + tostring(candidate.${field.member})] != nil {
        collision = true
      }
    },
    )
    let unique_records = unique_fields.map(
      |field| quote stmt {
      if candidate.${field.member} != nil {
        _seen[${field.name} + ":" + tostring(candidate.${field.member})] = true
      }
    },
    )
    let plan_fields = info.fields.map(|field| fake_plan_field(info, field, providers[field.index]))
    let hash = fake_schema_hash(info, providers)
    return quote items {
      impl ${info.ref} {
        /// Generate one value and advance the Faker row cursor.
        pub fn fake(faker: Faker) -> ${info.ref} {
          let row = faker.reserve(1)
          return ${info.ref}::fake_at(faker, row, ${info.name})
        }

        /// Generate the value at an explicit row/path without changing cursor.
        pub fn fake_at(faker: Faker, row: int, path_prefix: str = ${info.name}) -> ${info.ref} {
          return ${info.ref}.new(${..arguments})
        }

        /// Generate nominal values in deterministic chunks. PortableV1 performs
        /// no FFI; the native companion derive replaces the leaf executor.
        @allow(max_nesting_depth)
        pub fn fake_many(faker: Faker, count: int) -> [${info.ref}] {
          if count < 0 { panic("fake: count must be non-negative") }
          let start = faker.reserve(count)
          var values: [${info.ref}] = []
          var _seen = #{}
          var offset = 0
          while offset < count {
            let stop = if offset + faker.chunk_size < count { offset + faker.chunk_size } else { count }
            for index in offset..stop {
              var retry = 0
              loop {
                let retry_path = if retry == 0 { ${info.name} } else { ${info.name} + ".retry." + "{retry}" }
                let candidate = ${info.ref}::fake_at(faker, start + index, retry_path)
                var collision = false
                ${..unique_checks}
                if !collision {
                  ${..unique_records}
                  values.push(candidate)
                  break
                }
                retry = retry + 1
                if retry >= faker.retry_limit {
                  let message = "fake: unique generation for `" + ${info.name} + "` exhausted "
                    + "{faker.retry_limit}" + " retries at row " + "{start + index}"
                  panic(message)
                }
              }
            }
            offset = stop
          }
          return values
        }

        /// Inspect the static provider plan used by this type.
        pub fn fake_plan() -> {str: Any} {
          return #{
            "type_name": ${info.name},
            "schema_hash": ${hash},
            "fields": [${..plan_fields}],
            "algorithm": "portable-v1",
          }
        }
      }
    }
  }
}

/// Opt-in companion generator for native fake-rs batches. Keeping it apart
/// from `Fake` means a portable/wasm model never contains plugin dispatch.
/// It owns the same decorators, so one set of marks serves both.
pub derive FakeNative(infer: bool = true) owns marks {
  expand struct, schema(info) -> Syntax<.Items> {
    let providers = info.fields.map(|field| fake_provider_name(field, infer))
    for field in info.fields { fake_validate(field, providers[field.index]) }
    let native_arguments = info.fields.map(|field| fake_native_field_expr(field))
    let plan_fields = info.fields.map(|field| fake_plan_field(info, field, providers[field.index]))
    let hash = fake_schema_hash(info, providers)
    return quote items {
      impl ${info.ref} {
        pub fn fake_native_plan() -> {str: Any} {
          return #{
            "type_name": ${info.name},
            "schema_hash": ${hash},
            "fields": [${..plan_fields}],
            "algorithm": "fake-rs-v1",
          }
        }

        /// Call fake-rs once per chunk, then materialize the nominal Zolo type.
        pub fn fake_many_native(faker: Any, count: int) -> [${info.ref}] {
          if count < 0 { panic("fake-native: count must be non-negative") }
          let start = faker.reserve(count)
          var values: [${info.ref}] = []
          var offset = 0
          while offset < count {
            let stop = if offset + faker.chunk_size < count { offset + faker.chunk_size } else { count }
            let columns = faker.batch(${info.ref}::fake_native_plan(), start + offset, stop - offset)
            for index in 0..(stop - offset) { values.push(${info.ref}.new(${..native_arguments})) }
            offset = stop
          }
          return values
        }
      }
    }
  }
}
