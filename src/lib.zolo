//! fake — deterministic, typed fake data for Zolo.
//!
//! The default engine is PortableV1 and works on every backend. Import
//! `fake::native` only when the fake-rs plugin is available and high-volume
//! generation needs its batch executor.

/// Dataset locale. Every v1 P0 provider supports these three locales.
pub enum Locale {
  En,
  PtBr,
  FrFr,
}

/// Stable public engine identities. `Auto` resolves to PortableV1 in this
/// package-only build; `fake::native` exposes the opt-in FakeRsV1 executor.
pub enum Engine {
  Auto,
  PortableV1,
  FakeRsV1,
}

/// Providers accepted by `@provider(...)` on a field.
pub enum Provider {
  Auto,
  Int,
  Float,
  Chance,
  Word,
  FirstName,
  LastName,
  FullName,
  Username,
  SafeEmail,
  Domain,
  Ipv4,
  City,
  State,
  Postcode,
  Street,
  CompanyName,
  Profession,
  Industry,
  Sentence,
  Paragraph,
  UuidV4,
  Sequence,
}

/// One leaf slot in the compile-time plan generated by `deriving Fake`.
pub struct FieldPlan {
  pub name: str,
  pub path: str,
  pub kind: str,
  pub provider: str,
  pub min: int,
  pub max: int,
  pub probability: float,
  pub unique: bool,
}

/// Stable plan descriptor. The nominal constructor remains generated Zolo;
/// engines only see these leaf descriptions.
pub struct FakePlan {
  pub type_name: str,
  pub schema_hash: int,
  pub fields: [FieldPlan],
  pub algorithm: str = "portable-v1",
}

/// Per-instance deterministic generator. No process-global RNG is used.
pub struct Faker {
  pub seed: int = 0,
  pub locale: Locale = .En,
  pub fallback_locale: Locale? = nil,
  pub engine: Engine = .PortableV1,
  pub chunk_size: int = 1024,
  pub retry_limit: int = 32,
  pub cursor: int = 0,
}

fn fake_abs(value: int) -> int {
  if value < 0 { return -value }
  return value
}

